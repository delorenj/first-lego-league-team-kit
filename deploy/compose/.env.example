# Copy to .env:  cp .env.example .env
#
# Domain Caddy serves and auto-provisions HTTPS for.
#  - Local test:  leave as "localhost"  -> https://localhost (local cert)
#  - Public:      set to your domain    -> real HTTPS cert, but 80/443 must reach this box
#                 (port-forward, or use a Cloudflare Tunnel — see the deploy skill runbook).
SITE_DOMAIN=localhost
