# Copy to .env:  cp .env.example .env    (or let ./install.sh write it for you)
#
# The Traefik path is BRING-YOUR-OWN-INFRA. Every value here is yours — never a default
# pointing at someone else's domain, network, or tunnel.

# The domain you control and want the site served at.
SITE_DOMAIN=signup.yourtown.org

# The name of the EXISTING external Docker network your Traefik is attached to.
# Find it with:  docker network ls
PROXY_NETWORK=proxy

# The name of the certresolver configured in your Traefik static config (skip/ignore if a
# Cloudflare Tunnel is terminating TLS in front of Traefik).
CERT_RESOLVER=letsencrypt
