# Secrets — .env is materialized by `op inject -i .env.op > .env` on mise enter.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op
!.env.example

# Per-deployment site config — a team's own endpoint/email, like .env. Not shipped.
# The committed template is apps/web/config.example.js.
apps/web/config.js
