# Copy to .env:  cp .env.example .env     (or let ../../install.sh write it for you)
# This file configures the own-your-data stack (Caddy + the signup API). It's git-ignored.

# ── Required-ish ────────────────────────────────────────────────────────────
# The domain Caddy serves + auto-provisions HTTPS for. "localhost" = local test cert.
SITE_DOMAIN=localhost

# ── Roster view (recommended) ───────────────────────────────────────────────
# Set BOTH to unlock the private roster at https://SITE_DOMAIN/api/roster (HTTP Basic auth).
# Leave blank to disable the roster entirely (signups are still collected).
ROSTER_USER=coach
ROSTER_PASS=change-me-to-something-long

# ── Email notifications (optional) ──────────────────────────────────────────
# Get an email each time a family signs up. Needs SMTP_HOST + COACH_EMAIL at minimum.
# Example (Gmail app password, Fastmail, your ISP, etc.):
COACH_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1
